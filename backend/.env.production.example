# Set these in your backend hosting provider. Do not commit real values.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://YOUR_DATABASE_HOST:5432/YOUR_DATABASE_NAME?sslmode=require
DB_USERNAME=YOUR_DATABASE_USER
DB_PASSWORD=REPLACE_WITH_A_LONG_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_A_RANDOM_32_BYTE_OR_LONGER_SECRET
CORS_ALLOWED_ORIGINS=https://saving-saas.vercel.app
FRONTEND_URL=https://saving-saas.vercel.app
EMAIL_PROVIDER=resend
RESEND_API_KEY=REPLACE_WITH_A_RESEND_API_KEY
EMAIL_FROM=onboarding@resend.dev
# Set only while provisioning the first platform super-admin, then remove it.
SUPER_ADMIN_BOOTSTRAP_TOKEN=REPLACE_WITH_A_LONG_RANDOM_ONE_TIME_TOKEN
# Required for the platform-wide pg_dump backup feature. Use persistent storage
# for BACKUP_DIRECTORY; container-local files are lost when a service restarts.
DB_HOST=YOUR_DATABASE_HOST
DB_PORT=5432
DB_NAME=YOUR_DATABASE_NAME
BACKUP_DIRECTORY=/var/lib/ikiminaconnect/backups
